# PostgreSQL (Supabase)
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only password for the dashboard. Do not prefix with NEXT_PUBLIC_.
# The service role key is not used for login.
DASHBOARD_PASSWORD=
SUPABASE_STORAGE_BUCKET=product-images

# Optional: extra hosts treated as the public catalog site (comma-separated)
# Local catalog preview (no DNS): http://usados.localhost:3000
# CATALOG_HOSTS=

# Mercado Pago (producción). El access token no va al navegador.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
