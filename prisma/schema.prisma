generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  IPHONE
  MACBOOK
}

enum ProductStatus {
  AVAILABLE
  SOLD
  RESERVED
  ARCHIVED
}

enum PhysicalCondition {
  IMPECABLE
  EXCELENTE
  MUY_BUENO
  BUENO
  CON_DETALLES
}

enum ChipType {
  SIM
  ESIM
}

enum SaleChannel {
  CLIENTE
  FACEBOOK_MARKETPLACE
  INSTAGRAM
  REFERIDO
  GREMIO
  OTRO
}

model Product {
  id                 String             @id @default(cuid())
  internalCode       String             @unique
  type               ProductType
  name               String
  storage            String
  color              String
  imei               String?
  batteryCondition   Int?
  physicalCondition  PhysicalCondition
  chip               ChipType?
  cost               Float
  salePrice          Float
  description        String?
  status             ProductStatus      @default(AVAILABLE)
  isReserved         Boolean            @default(false)
  isPublished        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  images             ProductImage[]
  sale               Sale?

  @@index([imei])
  @@index([status, isPublished, type])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Sale {
  id         String      @id @default(cuid())
  productId  String      @unique
  soldPrice  Float
  channel    SaleChannel
  notes      String?
  soldAt     DateTime    @default(now())
  createdAt  DateTime    @default(now())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model AppCounter {
  id    String @id
  value Int    @default(0)
}

enum QuoteRevisionStatus {
  DRAFT
  PUBLISHED
}

enum QuotePenaltyKind {
  PERCENTAGE
  FIXED_USD
}

/// Commercial quote revisions. Not related to inventory products.
/// At most one row may be PUBLISHED. The partial unique index
/// QuotePricingRevision_one_published_idx enforces that in the database.
model QuotePricingRevision {
  id          String              @id @default(cuid())
  status      QuoteRevisionStatus @default(DRAFT)
  currency    String              @default("USD")
  note        String?
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  publishedAt DateTime?
  publishedBy String?
  basePrices  QuoteBasePrice[]
  penalties   QuotePenalty[]

  @@index([status, createdAt])
}

model QuoteBasePrice {
  id         String               @id @default(cuid())
  revisionId String
  model      String
  storage    String
  priceUsd   Int
  revision   QuotePricingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, model, storage])
  @@index([revisionId])
}

model QuotePenalty {
  id         String               @id @default(cuid())
  revisionId String
  key        String
  kind       QuotePenaltyKind
  value      Decimal              @db.Decimal(12, 4)
  revision   QuotePricingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, key])
  @@index([revisionId])
}
